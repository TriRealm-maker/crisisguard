# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=CrisisGuard

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_here

# OpenWeatherMap API Key (get free at openweathermap.org)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Ollama Configuration (for AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Groq API Key (get free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Email Configuration (Brevo HTTP API)
EMAIL_USER=your_email@example.com
BREVO_API_KEY=your_brevo_api_key_here